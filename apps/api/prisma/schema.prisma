// Esquema inicial de "Matemática bajo reglas".
// Decisiones de modelado: ver docs/architecture.md (sección "Modelo de datos").

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum AttemptOutcome {
  PENDING
  CORRECT
  INCORRECT
  TIMEOUT
}

enum AttemptFailureReason {
  SYNTAX_ERROR
  DIVISION_BY_ZERO
  WRONG_RESULT
  CLAIMED_RESULT_MISMATCH
  RULE_VIOLATION
  TIMEOUT
}

enum ScoreReason {
  CORRECT_ANSWER
  MANUAL_ADJUSTMENT
}

// ─────────────────── Usuarios, grupos y docentes ───────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupMemberships   GroupMembership[]
  teacherAssignments TeacherGroupAssignment[]
  worldProgress      StudentWorldProgress[]
  gameSessions       GameSession[]
  attempts           ChallengeAttempt[]
  scoreTransactions  ScoreTransaction[]

  @@map("users")
}

model Group {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        GroupMembership[]
  teacherAssignments TeacherGroupAssignment[]

  @@map("groups")
}

/// Un estudiante puede pertenecer a varios grupos.
model GroupMembership {
  id       String   @id @default(uuid(7)) @db.Uuid
  userId   String   @db.Uuid
  groupId  String   @db.Uuid
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_memberships")
}

/// Un docente gestiona varios grupos y un grupo puede tener varios docentes.
/// La autorización del docente se deriva únicamente de esta tabla.
/// Invariante de aplicación: `teacherId` debe referir a un usuario con rol TEACHER.
model TeacherGroupAssignment {
  id         String   @id @default(uuid(7)) @db.Uuid
  teacherId  String   @db.Uuid
  groupId    String   @db.Uuid
  assignedAt DateTime @default(now())

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupId])
  @@index([groupId])
  @@map("teacher_group_assignments")
}

// ─────────────── Catálogo: mundos, reglas y retos ───────────────

model World {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  /// Orden de presentación (1 = Aritmética … 5 = Caos matemático).
  position    Int      @unique
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules      Rule[]
  challenges Challenge[]
  progress   StudentWorldProgress[]
  sessions   GameSession[]
  scores     ScoreTransaction[]

  @@map("worlds")
}

/// Definición estructurada de una regla (tipo + configuración), separada de los retos.
model Rule {
  id          String   @id @default(uuid(7)) @db.Uuid
  worldId     String   @db.Uuid
  /// Identificador estable usado por el motor (p. ej. "arithmetic.forbidden-digit-2").
  key         String
  /// Tipo de regla (FORBIDDEN_DIGIT, REQUIRED_OPERATION, …). String para permitir nuevos tipos sin migración.
  type        String
  description String
  config      Json
  createdAt   DateTime @default(now())

  world        World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  introducedBy Challenge?
  unlockedBy   UnlockedRule[]

  @@unique([worldId, key])
  @@map("rules")
}

model Challenge {
  id                String   @id @default(uuid(7)) @db.Uuid
  worldId           String   @db.Uuid
  /// Posición (1-based) dentro de la secuencia del mundo.
  position          Int
  /// Expresión mostrada al jugador, p. ej. "3 * 7".
  expression        String
  /// Resultado esperado como fracción canónica ("21", "7/2").
  expectedResult    String
  /// Solución de referencia que cumple TODAS las reglas del mundo (garantía de resolubilidad).
  /// Nunca debe exponerse a estudiantes.
  referenceSolution String
  /// Regla que este reto desbloquea (máximo un reto por regla).
  introducesRuleId  String?  @unique @db.Uuid
  createdAt         DateTime @default(now())

  world          World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  introducesRule Rule?              @relation(fields: [introducesRuleId], references: [id], onDelete: SetNull)
  attempts       ChallengeAttempt[]

  @@unique([worldId, position])
  @@map("challenges")
}

// ───────────── Progreso del jugador por mundo ─────────────

/// Racha, puntos y posición independientes por (estudiante, mundo).
model StudentWorldProgress {
  id              String         @id @default(uuid(7)) @db.Uuid
  userId          String         @db.Uuid
  worldId         String         @db.Uuid
  /// Posición (1-based) del reto actual en la secuencia.
  currentPosition Int            @default(1)
  currentStreak   Int            @default(0)
  bestStreak      Int            @default(0)
  /// Caché del total; la fuente auditable es la suma de ScoreTransaction.points.
  totalPoints     Int            @default(0)
  status          ProgressStatus @default(IN_PROGRESS)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  world         World          @relation(fields: [worldId], references: [id], onDelete: Cascade)
  unlockedRules UnlockedRule[]

  @@unique([userId, worldId])
  @@map("student_world_progress")
}

/// Reglas acumuladas por jugador y mundo. Persisten tras fallos y reinicios de secuencia.
model UnlockedRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  progressId String   @db.Uuid
  ruleId     String   @db.Uuid
  unlockedAt DateTime @default(now())

  progress StudentWorldProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  rule     Rule                 @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([progressId, ruleId])
  @@map("unlocked_rules")
}

// ───────────── Sesiones, intentos y puntuación ─────────────

model GameSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  worldId   String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  world    World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  attempts ChallengeAttempt[]

  @@index([userId, worldId])
  @@map("game_sessions")
}

/// Historial de intentos (incluye fallos y timeouts). Un único intento por reto presentado.
/// Los tiempos (`startedAt`, `deadlineAt`, `submittedAt`) los fija SIEMPRE el servidor.
model ChallengeAttempt {
  id               String                @id @default(uuid(7)) @db.Uuid
  sessionId        String                @db.Uuid
  /// Denormalizado desde la sesión para consultas por estudiante/reto.
  userId           String                @db.Uuid
  challengeId      String                @db.Uuid
  outcome          AttemptOutcome        @default(PENDING)
  failureReason    AttemptFailureReason?
  submission       String?
  /// Valor evaluado de la expresión enviada (fracción canónica), si pudo evaluarse.
  evaluatedValue   String?
  /// Claves de las reglas activas en el momento del intento (auditoría y estadísticas).
  activeRuleKeys   String[]
  activeRulesCount Int
  timeLimitSeconds Int
  startedAt        DateTime              @default(now())
  deadlineAt       DateTime
  submittedAt      DateTime?
  streakBefore     Int
  pointsAwarded    Int                   @default(0)
  /// Violaciones de reglas detectadas (JSON estructurado).
  violations       Json?

  session          GameSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge        Challenge         @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  scoreTransaction ScoreTransaction?

  @@index([sessionId])
  @@index([userId, challengeId])
  @@map("challenge_attempts")
}

/// Libro mayor inmutable (solo inserciones) de puntos. Solo el backend inserta filas.
/// Puntos enteros y multiplicador en milésimas (1500 = 1.5x): sin aritmética de coma flotante.
model ScoreTransaction {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @db.Uuid
  worldId         String      @db.Uuid
  attemptId       String?     @unique @db.Uuid
  reason          ScoreReason
  basePoints      Int
  multiplierMilli Int
  points          Int
  streakAfter     Int
  createdAt       DateTime    @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  world   World             @relation(fields: [worldId], references: [id], onDelete: Restrict)
  attempt ChallengeAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([userId, worldId])
  @@map("score_transactions")
}
