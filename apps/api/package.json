{
  "name": "@mbr/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST (NestJS) de Matemática bajo reglas",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run db:generate && nest build",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "pretest": "npm run db:generate",
    "test": "npm run test:unit && npm run test:integration",
    "test:cov": "jest --selectProjects unit --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "auth:cleanup": "tsx prisma/auth-cleanup.ts",
    "db:studio": "prisma studio",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --no-warnings ../../node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:watch": "jest --selectProjects unit --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
