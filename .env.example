# Copia este archivo a `.env` (en la raíz del repositorio). NUNCA commitees `.env`.
# Lo leen: docker-compose (POSTGRES_*), la API (apps/api) y la CLI de Prisma.

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_USER=mbr
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=matematica_bajo_reglas
POSTGRES_PORT=5432
# Debe coincidir con los valores POSTGRES_* de arriba.
DATABASE_URL=postgresql://mbr:change-me-local-only@localhost:5432/matematica_bajo_reglas?schema=public

# ── API ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Conexiones máximas del pool de PostgreSQL (opcional; por defecto las de `pg`).
# DATABASE_POOL_MAX=10
# Origen permitido por CORS (URL del frontend en desarrollo).
CORS_ORIGIN=http://localhost:5173

# ── Reglas del juego (todas opcionales; estos son los valores por defecto) ──
# timeLimit = GAME_BASE_TIME_SECONDS + (reglasActivas - 1) * GAME_ADDITIONAL_TIME_PER_RULE_SECONDS
GAME_BASE_TIME_SECONDS=60
GAME_ADDITIONAL_TIME_PER_RULE_SECONDS=15
# Puntos base por acierto (entero) y multiplicador de racha: M(n) = min(1 + STEP·(n−1), MAX).
GAME_BASE_POINTS=100
GAME_STREAK_MULTIPLIER_STEP=0.5
GAME_MAX_STREAK_MULTIPLIER=5

# ── Autenticación (JWT) ────────────────────────────────────────────────────
# Mínimo 32 caracteres. El valor de ejemplo SOLO sirve en desarrollo (se rechaza con NODE_ENV=production).
# Genera uno real con: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
# Validez del token de acceso en segundos (por defecto 3600).
JWT_EXPIRES_IN_SECONDS=3600

# ── Proxy inverso (IP del cliente) ─────────────────────────────────────────
# La IP del cliente alimenta el limitador de login y el listado de sesiones. Sin definir = false: se IGNORA
# X-Forwarded-For. Detrás de UN proxy inverso que añade la IP real, pon 1. Sin esto detrás de un proxy, todos
# los clientes comparten la IP del proxy. Evita `true` (permite falsificar la IP).
# TRUST_PROXY=1

# ── Contraseñas (todas opcionales; ver docs/authentication.md) ─────────────
# Longitud mínima (8–64; por defecto 8; recomendado 12 en producción). Máximo fijo: 128. Sin reglas de composición.
# PASSWORD_MIN_LENGTH=12

# ── Limitación de intentos de login (valores por defecto = recomendados) ───
# Bloqueo temporal progresivo: LOCK_BASE · 2^(reincidencias-1), con tope LOCK_MAX. Nunca permanente.
# Aulas con una sola IP pública (NAT): sube LOGIN_MAX_ATTEMPTS_IP (300–500).
# LOGIN_MAX_ATTEMPTS_IP_EMAIL=5
# LOGIN_MAX_ATTEMPTS_EMAIL=20
# LOGIN_MAX_ATTEMPTS_IP=100
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCK_BASE_SECONDS=60
# LOGIN_LOCK_MAX_SECONDS=900
# Fallos con la contraseña actual en POST /auth/change-password antes de bloquear.
# PASSWORD_CHANGE_MAX_ATTEMPTS=5

# ── Recuperación de contraseña ─────────────────────────────────────────────
# PASSWORD_RESET_TTL_MINUTES=30
# PASSWORD_RESET_COOLDOWN_SECONDS=60
# PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
# URL del frontend; el correo enlaza a <URL>#token=<token>. Por defecto <CORS_ORIGIN>/reset-password.
# PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ── Correo ─────────────────────────────────────────────────────────────────
# disabled (por defecto): no envía nada. console: SOLO DESARROLLO, imprime el correo (con el token) en la consola
# del servidor; la API se niega a arrancar con console en producción. Un proveedor real: ver docs/authentication.md §6.
MAIL_TRANSPORT=console

# ── Mantenimiento de registros de autenticación ────────────────────────────
# Días que se conserva lo caducado (sesiones, tokens) antes de purgarlo, y cada cuántos minutos purga la API (0 = nunca;
# usa entonces `npm run auth:cleanup` desde un cron).
# AUTH_RETENTION_DAYS=30
# AUTH_CLEANUP_INTERVAL_MINUTES=360
